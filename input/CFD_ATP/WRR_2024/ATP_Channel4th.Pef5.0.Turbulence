!
! -*- input parameter for ATP -*-
!
! -*- mode: f90 -*-

!======================================
&ATPOptions
!======================================
 
  RestartFlag = F                ! restart or not
  numPrtcl=  600000              ! total particle number
  PI_Method  = 2                 ! Integration scheme for translational motion ( 1:FE, 2:AB2, 3:AB3 )
  numPrtcl_Type = 6              ! number of particle type

  RunName  = "ATP_PT_Pef5.0"             ! Run name
  ResultsDir = "./ATP/Results_PT_Pef2.00Pes0.20/"  ! Result directory
  RestartDir = "./ATP/Restart/"  ! Restart directory
  Cmd_LFile_Freq  = 200          ! Report frequency in the terminal is 500 time step
  LF_file_lvl     = 5            ! Logfile report level 
  LF_cmdw_lvl     = 3            ! Terminal report level

/End of NAMELIST "&ATPOptions"

!======================================
&SwimOptions
!======================================
 
  Bin_Divided = 1 1 1 1 1 1
  
  DiffuseR=0.066 0.066 0.066 0.066 0.066 0.066    ! Dr: Orientation diffusivity
  OneDtwoB=0.066 0.066 0.066 0.066 0.066 0.066        ! 1/2B
  SwimVelocityMag=4.0E-6 4.0E-5 4.0E-4 2.4E-3 4.0E-3 4.0E-2 ! Vs: Swim velocity
  
/End of NAMELIST "&SwimOptions"

!======================================
&ParticleStatisticOption
!======================================

 nslab   = 100
 nShannon= 100

/End of NAMELIST "&ParticleStatisticOption"

!======================================
&PrtclVisuOption
!======================================

  saveXDMFOnce   = T
  
  save_ID        = T
  save_Type      = T
  save_UsrMark   = F
  save_LinVel    = T
  save_SwimDir   = T
  save_MoveDist  = T
/End of NAMELIST "&PrtclVisuOption"

!===============================!
! -*- input parameters end -*- =!
!===============================!
